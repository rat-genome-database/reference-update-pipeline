<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           https://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean id="referenceUpdatePipeline" class="edu.mcw.rgd.ReferenceUpdatePipeline">
        <property name="version" value="reference-update-pipeline  -- build Jul 31, 2026"/>
        <property name="eUtils_db" value="Pubmed"/>
        <property name="eUtils_tool" value="RatGenomeDatabase"/>
        <property name="eUtils_email" value="mtutaj@mcw.edu"/>
        <property name="eutils_rettype" value="medline"/>
        <property name="eUtils_retmode" value="xml"/>
        <property name="ncbiFetchUrl" value="https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi"/>
        <property name="termSearchUrl" value="https://ontomate.rgd.mcw.edu/solr/select?q="/>
        <property name="attR" value="rows=10"/>
        <property name="eutilsBatchSize" value="100"/>
        <property name="htpFileName" value="/home/rgddata/pipelines/ftp-file-extracts-pipeline/data/agr/HTPDATASET_RGD.json" />

        <property name="pubmedImportUrl" value="/rgdweb/pubmed/importReferences.html?pmid_list=" />
        <property name="pubmedImportDepthInDays" value="30" />
        <property name="pubmedServices">
            <map>
                <entry key="travis" value="http://dev.rgd.mcw.edu" />
                <entry key="reed" value="http://pipelines.rgd.mcw.edu" />
                <entry key="default" value="http://dev.rgd.mcw.edu" />
            </map>
        </property>
        <property name="pubmedImportBatchSize" value="30" />
    </bean>

    <bean id="retractedReferences" class="edu.mcw.rgd.RetractedReferences">
        <!-- Retraction Watch database, published as a single CSV by Crossref; the 'name' parameter
             is how Crossref asks callers to identify themselves -->
        <property name="retractionWatchUrl" value="https://api.labs.crossref.org/data/retractionwatch?name=mtutaj@mcw.edu"/>
        <property name="localFile" value="data/retraction_watch.csv"/>
        <property name="maxRetryCount" value="2"/>
        <property name="downloadRetryInterval" value="20"/>

        <!-- logical name to column header in the downloaded CSV; 'recordId' is Retraction Watch's
             own row identifier and is what REFERENCES_RETRACTED is synchronized on -->
        <property name="columns">
            <map>
                <entry key="recordId" value="Record ID"/>
                <entry key="originalPmid" value="OriginalPaperPubMedID"/>
                <entry key="retractionPmid" value="RetractionPubMedID"/>
                <entry key="retractionDate" value="RetractionDate"/>
                <entry key="nature" value="RetractionNature"/>
                <entry key="reason" value="Reason"/>
            </map>
        </property>

        <!-- how many of the most frequent retraction reasons to write to the debug log -->
        <property name="topReasonCount" value="15"/>

        <!-- RetractionNature value that means the paper really was retracted; the same file also
             carries 'Correction', 'Expression of concern' and 'Reinstatement', and those must not
             be reported as retractions -->
        <property name="retractionNature" value="Retraction"/>

        <!-- prepended to the title of a reference when it is withdrawn as retracted -->
        <property name="titlePrefix" value="RETRACTED: "/>

        <!-- when true, the module reports what it would do but withdraws nothing, retitles nothing
             and moves no annotations out of FULL_ANNOT. Set to false to let it act. -->
        <property name="dryRun" value="true"/>

        <!-- date formats tried, in order, against the RetractionDate column -->
        <property name="retractionDateFormats">
            <list>
                <value>M/d/yyyy H:mm</value>
                <value>M/d/yyyy</value>
                <value>yyyy-MM-dd</value>
            </list>
        </property>
    </bean>

    <bean id="importReferencesForAlliance" class="edu.mcw.rgd.ImportReferencesForAlliance">
        <property name="importPubMedUrl" value="/rgdweb/pubmed/importReferences.html?pmid_list=" />
        <property name="importPubmedToolHost">
            <map>
                <entry key="travis" value="https://dev.rgd.mcw.edu" />
                <entry key="default" value="https://dev.rgd.mcw.edu" />
                <entry key="reed" value="https://pipelines.rgd.mcw.edu" />
            </map>
        </property>
    </bean>
</beans>


